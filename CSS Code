@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Kalam:wght@400;700&display=swap');

:root {
    --paper: #f8f3e8;
    --white: #fffdf7;
    --ink: #303d32;
    --muted: #788071;
    --green: #667b5c;
    --yellow: #f3cb67;
    --line: #ded6c5;
    --soft-green: #edf0e4;
}

* {
    box-sizing: border-box;
}

[hidden] {
    display: none !important;
}

body {
    margin: 0;
    padding: 25px 16px;
    background-color: var(--paper);
    background-image: radial-gradient(#d8cfbd 0.6px, transparent 0.6px);
    background-size: 17px 17px;
    color: var(--ink);
    font-family: 'DM Sans', Arial, sans-serif;
}

.page {
    max-width: 650px;
    margin: 0 auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding-bottom: 17px;
    border-bottom: 1px solid var(--line);
}

.logo {
    color: var(--ink);
    text-decoration: none;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -2px;
}

.logo span,
.intro h1 span {
    color: #c99a37;
}

.header-note {
    color: var(--muted);
    font-family: 'Kalam', cursive;
    font-size: 14px;
    transform: rotate(-2deg);
}

.intro {
    margin: 48px 0 26px;
}

.small-label {
    color: var(--green);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

.intro h1 {
    margin: 12px 0;
    font-family: 'Kalam', cursive;
    font-size: clamp(36px, 8vw, 53px);
    line-height: 1.12;
    letter-spacing: -1.5px;
}

.intro-text {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
}

.search-form {
    display: flex;
    gap: 9px;
    padding: 7px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 3px 4px 0 #e5ddcc;
}

.search-form input {
    flex: 1;
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: none;
    outline: none;
    color: var(--ink);
    background: transparent;
    font-family: inherit;
    font-size: 14px;
}

.search-form input::placeholder {
    color: #a2a393;
}

button {
    font-family: inherit;
    cursor: pointer;
}

.search-form button {
    padding: 11px 15px;
    border: none;
    border-radius: 8px;
    color: white;
    background: var(--green);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
}

.search-form button:hover {
    background: #4f6547;
}

button:disabled {
    opacity: 0.6;
    cursor: wait;
}

.location-btn {
    margin-top: 15px;
    padding: 8px 0;
    border: none;
    color: var(--green);
    background: transparent;
    font-size: 12px;
}

.location-btn:hover {
    text-decoration: underline;
}

.message {
    min-height: 20px;
    margin: 15px 0 25px;
    color: var(--muted);
    font-size: 12px;
}

.weather-paper {
    position: relative;
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--white);
    box-shadow: 5px 6px 0 #e7dfce;
}

.weather-paper::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 38%;
    width: 70px;
    height: 15px;
    background: rgba(243, 203, 103, 0.65);
    transform: rotate(-3deg);
}

.paper-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.paper-top .small-label {
    margin-top: 0;
}

.paper-top h2 {
    margin: 7px 0;
    font-size: clamp(20px, 5vw, 27px);
}

.date {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}

.weather-icon {
    font-size: clamp(47px, 10vw, 75px);
    transform: rotate(5deg);
}

.temperature-area {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 28px 0;
}

.temperature {
    margin: 0;
    font-size: clamp(65px, 15vw, 91px);
    line-height: 1;
    letter-spacing: -6px;
    font-weight: 500;
}

.condition {
    margin: 0 0 8px;
    font-family: 'Kalam', cursive;
    font-size: 22px;
    font-weight: 700;
}

.high-low {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}

.little-note {
    padding: 15px 17px;
    border-left: 3px solid var(--yellow);
    background: #faf5e6;
    transform: rotate(-0.4deg);
}

.note-title {
    color: #746238;
    font-family: 'Kalam', cursive;
    font-size: 16px;
    font-weight: 700;
}

.little-note p {
    margin: 8px 0 0;
    color: #696956;
    font-size: 13px;
    line-height: 1.6;
}

.paper-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 23px;
    padding-top: 15px;
    border-top: 1px dashed var(--line);
    color: var(--muted);
    font-family: 'Kalam', cursive;
    font-size: 14px;
}

.unit-switch {
    display: flex;
    gap: 4px;
}

.unit {
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
}

.unit.active {
    border-color: var(--green);
    color: white;
    background: var(--green);
}

.forecast-section,
.details-section {
    margin-top: 40px;
}

.section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 16px;
}

.section-title h2 {
    margin: 0;
    font-family: 'Kalam', cursive;
    font-size: 22px;
}

.section-title > span {
    color: var(--muted);
    font-size: 10px;
}

.forecast {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
}

.forecast-item {
    padding: 13px 3px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 253, 247, 0.8);
    text-align: center;
}

.forecast-time {
    color: var(--muted);
    font-size: 10px;
}

.forecast-icon {
    margin: 12px 0;
    font-size: 22px;
}

.forecast-temp {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
}

.forecast-rain {
    margin-top: 9px;
    color: var(--green);
    font-size: 10px;
}

.details-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
}

.detail {
    padding: 16px;
    border: 1px dashed #cfc7b5;
    border-radius: 10px;
    background: rgba(255, 253, 247, 0.7);
}

.detail > span {
    font-size: 22px;
}

.detail p {
    margin: 9px 0 5px;
    color: var(--muted);
    font-size: 12px;
}

.detail strong {
    font-size: 20px;
}

.updated {
    margin-top: 20px;
    color: var(--muted);
    text-align: center;
    font-size: 11px;
}

.footer {
    margin-top: 50px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    text-align: center;
}

.footer-doodle {
    color: var(--green);
    font-size: 21px;
    letter-spacing: 10px;
}

.footer p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
}

.footer a {
    color: var(--green);
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

@media (max-width: 440px) {
    body {
        padding: 18px 13px;
    }

    .header-note {
        max-width: 125px;
        text-align: right;
    }

    .intro {
        margin-top: 37px;
    }

    .search-form {
        gap: 4px;
    }

    .search-form input {
        padding: 10px 5px;
        font-size: 12px;
    }

    .search-form button {
        padding: 10px;
        font-size: 12px;
    }

    .weather-paper {
        padding: 20px 16px;
    }

    .temperature-area {
        gap: 15px;
    }

    .forecast {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
    }

    .section-title {
        align-items: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        scroll-behavior: auto;
    }
}
